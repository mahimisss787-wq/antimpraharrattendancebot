    {
      "parameters": {
        "jsCode": "const today = DateTime.now().setZone('Asia/Kolkata').toFormat('dd-MM-yyyy');\n\n// Fetch members list\nconst members = $('Read Members Sheet').all().map(i => i.json);\nconst totalMembersCount = members.length;\n\n// Fetch all attendance records\nconst attendance = $('Read Attendance Sheet for Report').all().map(i => i.json);\n\n// Filter today's attendance\nconst todayAttendance = attendance.filter(r => String(r['Date'] || '').trim() === today);\n\n// Parse present and leave users\nconst presentUsers = todayAttendance.filter(r => String(r['Status'] || 'Present').trim() === 'Present');\nconst leaveUsers = todayAttendance.filter(r => String(r['Status'] || '').trim() === 'Leave');\n\nconst presentUserIds = new Set(presentUsers.map(u => String(u['User ID']).trim()));\nconst leaveUserIds = new Set(leaveUsers.map(u => String(u['User ID']).trim()));\n\n// Find absentees (members not present and not on leave today)\nconst absentUsers = members.filter(m => !presentUserIds.has(String(m['User ID']).trim()) && !leaveUserIds.has(String(m['User ID']).trim()));\n\n// 3-Day Absent warning calculation\nconst warnings = [];\nconst yesterday = DateTime.now().setZone('Asia/Kolkata').minus({ days: 1 }).toFormat('dd-MM-yyyy');\nconst dayBefore = DateTime.now().setZone('Asia/Kolkata').minus({ days: 2 }).toFormat('dd-MM-yyyy');\n\nfor (const member of absentUsers) {\n  const mId = String(member['User ID']).trim();\n  // Check if absent yesterday and day before (i.e. not in attendance for those days)\n  const attendedYesterday = attendance.some(r => String(r['Date'] || '').trim() === yesterday && String(r['User ID'] || '').trim() === mId);\n  const attendedDayBefore = attendance.some(r => String(r['Date'] || '').trim() === dayBefore && String(r['User ID'] || '').trim() === mId);\n  \n  if (!attendedYesterday && !attendedDayBefore) {\n    warnings.push(member.Name || member.name || 'Unknown');\n  }\n}\n\n// Build report text\nlet presentNamesText = presentUsers.length\n  ? presentUsers.map((user, index) => `${index + 1}. ${user.Name || user.name || 'Unknown'}`).join('\\n')\n  : 'None';\n\nlet leaveNamesText = leaveUsers.length\n  ? leaveUsers.map((user, index) => `${index + 1}. ${user.Name || user.name || 'Unknown'} (${user.Reason || 'No reason'})`).join('\\n')\n  : 'None';\n\nlet absentNamesText = absentUsers.length\n  ? absentUsers.map((user, index) => `${index + 1}. ${user.Name || user.name || 'Unknown'}`).join('\\n')\n  : 'None';\n\nlet warningsText = warnings.length\n  ? warnings.map((name, index) => `${index + 1}. ${name}`).join('\\n')\n  : 'None';\n\nreturn [{\n  json: {\n    date: today,\n    presentCount: presentUsers.length,\n    leaveCount: leaveUsers.length,\n    absentCount: absentUsers.length,\n    totalMembers: totalMembersCount,\n    presentNamesText,\n    leaveNamesText,\n    absentNamesText,\n    warningsText\n  }\n}];"
      },
