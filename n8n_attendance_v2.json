    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst today = $now.setZone('Asia/Kolkata');\nconst currentMonthYear = today.toFormat('MM-yyyy');\n\nconst monthlyRows = rows.filter(r => {\n  const dateStr = String(r['Date'] || '').trim();\n  return dateStr.endsWith(currentMonthYear);\n});\n\nconst uniqueDates = Array.from(new Set(monthlyRows.map(r => String(r['Date'] || '').trim()))).filter(Boolean);\nconst totalDaysOpen = uniqueDates.length;\n\nconst userStats = {};\nfor (const r of monthlyRows) {\n  const userId = String(r['User ID'] || '').trim();\n  if (!userId) continue;\n  \n  const name = String(r['Name'] || 'Unknown').trim();\n  const status = String(r['Status'] || 'Present').trim().toLowerCase();\n  \n  if (!userStats[userId]) {\n    userStats[userId] = {\n      name: name,\n      present: 0,\n      leave: 0\n    };\n  }\n  if (status === 'leave') {\n    userStats[userId].leave++;\n  } else {\n    userStats[userId].present++;\n  }\n}\n\nconst sortedUsers = Object.values(userStats).sort((a, b) => b.present - a.present);\nconst topList = sortedUsers.slice(0, 5).map((u, i) => `${i+1}. ${u.name} (Present: ${u.present}, Leave: ${u.leave})`).join('\\n');\n\nconst totalMembers = 29;\nlet totalPresentsThisMonth = 0;\nfor (const u of Object.values(userStats)) {\n  totalPresentsThisMonth += u.present;\n}\nconst averageAttendance = totalDaysOpen > 0 \n  ? ((totalPresentsThisMonth / (totalMembers * totalDaysOpen)) * 100).toFixed(1) \n  : 0;\n\nconst sortedDates = uniqueDates.map(d => {\n  const parts = d.split('-');\n  return {\n    str: d,\n    dateObj: new Date(parts[2], parts[1] - 1, parts[0])\n  };\n}).sort((a, b) => a.dateObj - b.dateObj).map(d => d.str);\n\nconst last7Dates = sortedDates.slice(-7);\n\nconst chartPresents = [];\nconst chartLeaves = [];\nconst chartLabels = [];\n\nfor (const d of last7Dates) {\n  const dayRows = rows.filter(r => String(r['Date'] || '').trim() === d);\n  const uniqueUsersThisDay = new Map();\n  let presents = 0;\n  let leaves = 0;\n  for (const r of dayRows) {\n    const userId = String(r['User ID'] || '').trim();\n    if (!userId || uniqueUsersThisDay.has(userId)) continue;\n    uniqueUsersThisDay.set(userId, true);\n    if (String(r['Status'] || 'Present').trim().toLowerCase() === 'leave') {\n      leaves++;\n    } else {\n      presents++;\n    }\n  }\n  chartPresents.push(presents);\n  chartLeaves.push(leaves);\n  const parts = d.split('-');\n  chartLabels.push(`${parts[0]}/${parts[1]}`);\n}\n\nconst chartConfig = {\n  type: 'bar',\n  data: {\n    labels: chartLabels,\n    datasets: [\n      {\n        label: 'Present ✅',\n        backgroundColor: 'rgba(16, 185, 129, 0.8)',\n        borderColor: '#10B981',\n        borderWidth: 1,\n        data: chartPresents\n      },\n      {\n        label: 'Leave 🌿',\n        backgroundColor: 'rgba(245, 158, 11, 0.8)',\n        borderColor: '#F59E0B',\n        borderWidth: 1,\n        data: chartLeaves\n      }\n    ]\n  },\n  options: {\n    title: {\n      display: true,\n      text: 'Attendance Trend (Last 7 Days)'\n    },\n    scales: {\n      yAxes: [{\n        ticks: {\n          beginAtZero: true,\n          max: 29\n        }\n      }]\n    }\n  }\n};\n\nconst chartUrl = `https://quickchart.io/chart?c=${encodeURIComponent(JSON.stringify(chartConfig))}`;\nconst monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\nconst currentMonthName = monthNames[today.month - 1];\n\nconst statsText = `📊 *Attendance Statistics - ${currentMonthName} ${today.year}*\\n\\n🗓️ *Days Active*: ${totalDaysOpen}\\n📈 *Average Attendance*: ${averageAttendance}%\\n👥 *Total Enrolled Members*: ${totalMembers}\\n\\n🏆 *Top Consistent Members (Presents/Leaves)*:\\n${topList || 'No records yet.'}\\n\\nKeep up the consistency! 🌟`;\n\nconst chat_id = $item(0).$node['Telegram Trigger1'].json.message.chat.id;\n\nreturn [{\n  json: {\n    chat_id,\n    photo: chartUrl,\n    caption: statsText,\n    parse_mode: 'Markdown'\n  }\n}];"
      },
