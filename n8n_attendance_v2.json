    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const msgText = (item.json.message && item.json.message.text || '').trim();\n  const chatType = item.json.message && item.json.message.chat && item.json.message.chat.type;\n\n  let command = 'unknown';\n\n  if (/^\\/present/i.test(msgText)) {\n    if (chatType === 'private') {\n      command = 'error_private_chat';\n    } else {\n      command = 'present';\n    }\n  } else if (/^\\/leave/i.test(msgText)) {\n    if (chatType === 'private') {\n      command = 'error_private_chat';\n    } else {\n      command = 'leave';\n    }\n  } else if (/^\\/summary/i.test(msgText)) {\n    command = 'summary';\n  } else if (/^\\/stats/i.test(msgText)) {\n    command = 'stats';\n  } else if (/^\\/[Aa]dmission ?[Ff]orm$/i.test(msgText)) {\n    command = 'admission';\n  }\n  \n  item.json.parsedCommand = command;\n}\n\nreturn $input.all();"
      },
