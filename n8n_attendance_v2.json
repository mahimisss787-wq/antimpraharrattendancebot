    {
      "parameters": {
        "jsCode": "const today = $now.setZone('Asia/Kolkata').toFormat('dd-MM-yyyy');\nconst rows = $input.all().map(i => i.json || {});\nconst todayRows = rows.filter(r => String(r['Date'] || '').trim() === today);\n\nconst uniqueUsers = new Map();\nlet presentCount = 0;\nlet leaveCount = 0;\n\nfor (const row of todayRows) {\n  const userId = String(row['User ID'] || '').trim();\n  if (!userId) continue;\n  \n  const status = String(row['Status'] || 'Present').trim().toLowerCase();\n  \n  if (!uniqueUsers.has(userId)) {\n    uniqueUsers.set(userId, {\n      name: String(row['Name'] || 'Unknown').trim(),\n      status: status\n    });\n    if (status === 'leave') {\n      leaveCount++;\n    } else {\n      presentCount++;\n    }\n  }\n}\n\nconst totalMembers = 29;\nconst absentCount = Math.max(0, totalMembers - presentCount - leaveCount);\nconst chat_id = $item(0).$node['Telegram Trigger1'].json.message.chat.id;\n\nconst messageText = `📋 *Live Attendance Summary*\\n📅 *Date*: ${today}\\n👥 *Total Members*: ${totalMembers}\\n\\n✅ *Present*: ${presentCount}\\n🌿 *On Leave*: ${leaveCount}\\n❌ *Absent*: ${absentCount}\\n\\nKeep learning, keep growing! ✨`;\n\nreturn [{\n  json: {\n    chat_id,\n    text: messageText,\n    parse_mode: 'Markdown'\n  }\n}];"
      },
