    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json || {});\nconst today = $now.setZone('Asia/Kolkata').toFormat('dd-MM-yyyy');\nconst todayRows = rows.filter(r => String(r['Date'] || '').trim() === today);\n\nconst uniqueUsers = new Map();\nlet presentCount = 0;\nlet leaveCount = 0;\n\nfor (const row of todayRows) {\n  const userId = String(row['User ID'] || '').trim();\n  if (!userId) continue;\n\n  const status = String(row['Status'] || 'Present').trim().toLowerCase();\n  const name = String(row['Name'] || 'Unknown').trim();\n\n  if (!uniqueUsers.has(userId)) {\n    uniqueUsers.set(userId, { name, status });\n    if (status === 'leave') {\n      leaveCount++;\n    } else {\n      presentCount++;\n    }\n  }\n}\n\nconst totalMembers = 29;\nconst absentCount = Math.max(0, totalMembers - presentCount - leaveCount);\n\nconst presentNames = [];\nconst leaveNames = [];\n\nfor (const [userId, user] of uniqueUsers.entries()) {\n  if (user.status === 'leave') {\n    leaveNames.push(user.name);\n  } else {\n    presentNames.push(user.name);\n  }\n}\n\nconst presentNamesText = presentNames.length\n  ? presentNames.map((name, index) => `${index + 1}. ${name}`).join('\\n')\n  : 'No one marked present today.';\n\nconst leaveNamesText = leaveNames.length\n  ? leaveNames.map((name, index) => `${index + 1}. ${name}`).join('\\n')\n  : 'No one on leave today.';\n\n// Get unique dates to generate trend line\nconst uniqueDates = Array.from(new Set(rows.map(r => String(r['Date'] || '').trim()))).filter(Boolean);\n\nconst sortedDates = uniqueDates.map(d => {\n  const parts = d.split('-');\n  return {\n    str: d,\n    dateObj: new Date(parts[2], parts[1] - 1, parts[0])\n  };\n}).sort((a, b) => a.dateObj - b.dateObj).map(d => d.str);\n\nconst last7Dates = sortedDates.slice(-7);\n\nconst chartPresents = [];\nconst chartLeaves = [];\nconst chartLabels = [];\n\nfor (const d of last7Dates) {\n  const dayRows = rows.filter(r => String(r['Date'] || '').trim() === d);\n  const uniqueUsersThisDay = new Map();\n  let presents = 0;\n  let leaves = 0;\n  for (const r of dayRows) {\n    const userId = String(r['User ID'] || '').trim();\n    if (!userId || uniqueUsersThisDay.has(userId)) continue;\n    uniqueUsersThisDay.set(userId, true);\n    if (String(r['Status'] || 'Present').trim().toLowerCase() === 'leave') {\n      leaves++;\n    } else {\n      presents++;\n    }\n  }\n  chartPresents.push(presents);\n  chartLeaves.push(leaves);\n  const parts = d.split('-');\n  chartLabels.push(`${parts[0]}/${parts[1]}`);\n}\n\nconst chartConfig = {\n  type: 'line',\n  data: {\n    labels: chartLabels,\n    datasets: [\n      {\n        label: 'Present ✅',\n        borderColor: '#10B981',\n        backgroundColor: 'rgba(16, 185, 129, 0.1)',\n        fill: true,\n        data: chartPresents\n      },\n      {\n        label: 'Leave 🌿',\n        borderColor: '#F59E0B',\n        backgroundColor: 'rgba(245, 158, 11, 0.1)',\n        fill: true,\n        data: chartLeaves\n      }\n    ]\n  },\n  options: {\n    title: {\n      display: true,\n      text: 'Weekly Attendance Trend'\n    },\n    scales: {\n      yAxes: [{\n        ticks: {\n          beginAtZero: true,\n          max: 29\n        }\n      }]\n    }\n  }\n};\n\nconst chartUrl = `https://quickchart.io/chart?c=${encodeURIComponent(JSON.stringify(chartConfig))}`;\n\nconst reportText = `📋 *Daily Attendance Report*\\n\\n📅 *Date*: ${today}\\n👥 *Total Members*: ${totalMembers}\\n✅ *Present*: ${presentCount}\\n🌿 *On Leave*: ${leaveCount}\\n❌ *Absent*: ${absentCount}\\n\\n📝 *Present Members*:\\n${presentNamesText}\\n\\n🌿 *Members on Leave*:\\n${leaveNamesText}`;\n\nreturn [{\n  json: {\n    chat_id: \"-1003493006883\",\n    photo: chartUrl,\n    caption: reportText,\n    parse_mode: 'Markdown'\n  }\n}];"
      },
